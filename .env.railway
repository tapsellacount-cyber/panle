# =============================================
# PasarGuard Panel - Railway Environment Config
# =============================================

# Admin credentials (REQUIRED - change these!)
SUDO_USERNAME=admin
SUDO_PASSWORD=change_me_strong_password

# Server settings (Railway sets PORT automatically)
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Database - Use Railway PostgreSQL plugin (recommended)
# After adding PostgreSQL plugin in Railway, it sets DATABASE_URL automatically
# Copy that value here in this format:
# SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# For quick start with SQLite (not recommended for production):
# SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///db.sqlite3

# Allow all origins (change to your domain in production)
ALLOWED_ORIGINS=*

# Enable reverse proxy headers (Railway uses a proxy)
UVICORN_PROXY_HEADERS=True
UVICORN_FORWARDED_ALLOW_IPS=*
